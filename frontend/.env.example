# Local ASP.NET launch URL. Used by Vite only, never exposed in the client bundle.
API_PROXY_TARGET=http://localhost:5000
# Keep /api for same-origin production hosting behind ASP.NET or a reverse proxy.
VITE_API_BASE_URL=/api
# Enable only after GET /api/tournaments implements the documented contract.
VITE_USE_API=false
# Enable only after POST /api/registrations validates and persists submissions.
VITE_ENABLE_REGISTRATION=false
